# BOX API CONFIGURATION (Client Credentials Grant)
BOX_CLIENT_ID="your_box_client_id_here"
BOX_CLIENT_SECRET="your_box_client_secret_here"
BOX_ENTERPRISE_ID="your_box_enterprise_id_here"

# CLOUDFLARE R2 CONFIGURATION
# Format: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ENDPOINT="your_cloudflare_r2_endpoint_here"
R2_ACCESS_KEY_ID="your_r2_access_key_id_here"
R2_SECRET_ACCESS_KEY="your_r2_secret_access_key_here"
R2_BUCKET_NAME="your_r2_bucket_name_here"

# SCRIPT CONFIGURATION
# The ID of the Box folder where your assets are stored
BOX_SOURCE_FOLDER_ID="your_box_folder_id_here"
